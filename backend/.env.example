# OpenRouter API key — used for intent classification and plain-English responses
LLM_API_KEY=your-openrouter-api-key

# Set to false to enable real AWS calls for write actions (restart, stop, alarms)
AWS_MOCK=true

# AWS region for boto3 clients
AWS_REGION=ap-south-1

# Only required when AWS_MOCK=false and executing real AWS actions
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
